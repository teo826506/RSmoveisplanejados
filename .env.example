# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Read/Write Token for uploaded project images
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_sample"

# WhatsApp Business number (only numbers: country code + DDD + number)
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999998888"

# Production Site URL
NEXT_PUBLIC_SITE_URL="https://rsplanejados.vercel.app"

# Admin Authentication
ADMIN_EMAIL="admin@rsplanejados.com.br"
ADMIN_PASSWORD="admin_senha_segura_123"

