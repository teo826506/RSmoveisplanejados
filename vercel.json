{
  "outputDirectory": "dist",
  "buildCommand": "DATABASE_URL=\"postgresql://postgres:postgres@dummy:5432/dummy\" npx prisma generate && vite build",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{api/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
